# Plane environment configuration
# Managed by Ansible - do not edit manually

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
INSTALL_DIR={{ plane_base_dir }}
DOMAIN_NAME={{ plane_app_domain }}
APP_DOMAIN={{ plane_app_domain }}
WEB_URL=https://{{ plane_app_domain }}
CORS_ALLOWED_ORIGINS=https://{{ plane_app_domain }},http://localhost
APP_RELEASE={{ plane_version }}
DEBUG=0
FILE_SIZE_LIMIT=5242880
SITE_ADDRESS=:80
API_KEY_RATE_LIMIT=60/minute

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
LISTEN_HTTP_PORT={{ plane_http_port }}
LISTEN_HTTPS_PORT=443
APP_PROTOCOL=http
TRUSTED_PROXIES=0.0.0.0/0

# ---------------------------------------------------------------------------
# SSL (handled externally by NPM)
# ---------------------------------------------------------------------------
CERT_EMAIL=
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
SECRET_KEY={{ plane_secret_key }}
LIVE_SERVER_SECRET_KEY={{ plane_live_server_secret_key }}
API_BASE_URL=http://api:8000

# ---------------------------------------------------------------------------
# Database — external PostgreSQL
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://{{ plane_db_user }}:{{ plane_db_password }}@{{ plane_db_hostname }}:{{ plane_db_port }}/{{ plane_db_name }}
PGHOST={{ plane_db_hostname }}
PGPORT={{ plane_db_port }}
PGDATABASE={{ plane_db_name }}
PGDATA=/var/lib/postgresql/data
POSTGRES_USER={{ plane_db_user }}
POSTGRES_PASSWORD={{ plane_db_password }}
POSTGRES_DB={{ plane_db_name }}
POSTGRES_PORT={{ plane_db_port }}

# ---------------------------------------------------------------------------
# Redis — internal container
# Podman auto-names containers "systemd-<service>" when ContainerName is not
# set in the Quadlet. install.sh does not set ContainerName, so the DNS name
# on the Podman network is systemd-plane-redis, not plane-redis.
# ---------------------------------------------------------------------------
REDIS_HOST=systemd-plane-redis
REDIS_PORT=6379
REDIS_URL=redis://systemd-plane-redis:6379/

# ---------------------------------------------------------------------------
# RabbitMQ — internal container (same naming caveat as Redis above)
# ---------------------------------------------------------------------------
RABBITMQ_HOST=systemd-plane-mq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER={{ plane_mq_user }}
RABBITMQ_DEFAULT_PASS={{ plane_mq_password }}
RABBITMQ_DEFAULT_VHOST=plane
RABBITMQ_VHOST=plane
AMQP_URL=amqp://{{ plane_mq_user }}:{{ plane_mq_password }}@systemd-plane-mq:5672/plane

# ---------------------------------------------------------------------------
# Object storage — internal MinIO container
# ---------------------------------------------------------------------------
USE_MINIO=1
MINIO_ENDPOINT_SSL=0
MINIO_ROOT_USER={{ plane_minio_access_key }}
MINIO_ROOT_PASSWORD={{ plane_minio_secret_key }}
AWS_REGION=
AWS_ACCESS_KEY_ID={{ plane_minio_access_key }}
AWS_SECRET_ACCESS_KEY={{ plane_minio_secret_key }}
AWS_S3_BUCKET_NAME={{ plane_minio_bucket }}
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
BUCKET_NAME={{ plane_minio_bucket }}
MINIO_SITE_URL=https://{{ plane_app_domain }}

# ---------------------------------------------------------------------------
# Performance / replicas
# ---------------------------------------------------------------------------
GUNICORN_WORKERS=2
WEB_REPLICAS=1
SPACE_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1
LIVE_REPLICAS=1
SILO_REPLICAS=1
IFRAMELY_REPLICAS=1
AUTOMATION_CONSUMER_REPLICAS=1
OUTBOX_POLLER_REPLICAS=1

# Disabled by default — set to 1 to enable
EMAIL_REPLICAS=0
PI_API_REPLICAS=0
PI_BEAT_REPLICAS=0
PI_WORKER_REPLICAS=0
PI_MIGRATOR_REPLICAS=0
