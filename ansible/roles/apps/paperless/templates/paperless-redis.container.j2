[Unit]
Description={{ paperless_app_name }} Redis container
After=network-online.target

[Container]
Image={{ paperless_redis_image }}
ContainerName={{ paperless_app_name }}-redis
Network={{ paperless_app_name }}.network
Volume={{ paperless_app_name }}-redis.volume:/data
HealthCmd=redis-cli ping
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target