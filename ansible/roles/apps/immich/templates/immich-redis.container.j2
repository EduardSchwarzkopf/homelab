[Unit]
Description={{ immich_app_name }} Redis container
After=network-online.target

[Container]
Image={{ immich_redis_image }}
ContainerName={{ immich_app_name }}-redis
Network={{ immich_app_name }}.network
Volume={{ immich_app_name }}-redis.volume:/data
HealthCmd=redis-cli ping
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target